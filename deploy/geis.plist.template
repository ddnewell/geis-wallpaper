<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>at.newell.geis.changewallpaper</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{INSTALL_DIR}}/geis</string>
        <string>--config</string>
        <string>{{INSTALL_DIR}}/config.json</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/GEIS/geis.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/GEIS/geis.err.log</string>
</dict>
</plist>
